{
  "name": "claude-compass",
  "version": "0.2.0",
  "private": true,
  "description": "Local chat colors, activity reports, and a session agent mailbox for Claude in Chrome.",
  "scripts": {
    "test": "node --test tests/core.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:accessibility": "node tests/accessibility.cjs",
    "test:all": "npm test && npm run test:browser && npm run test:accessibility",
    "package": "python3 scripts/package.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharmaromir/claude-compass.git"
  }
}
